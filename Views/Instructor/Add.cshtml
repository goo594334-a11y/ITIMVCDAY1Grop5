@model InstructorAddViewModel
@{
    ViewData["Title"] = "Add Instructor";
}

<h2>Add Instructor</h2>

<form action="/Instructor/Add" method="post">

    <div class="form-group">
        <label for="InsName">Name:</label>

        <input type="text"
               class="form-control"
               id="InsName"
               name="InsName"
               required />
    </div>

    <div class="form-group">
        <label for="InsAddress">Address:</label>

        <input type="text"
               class="form-control"
               id="InsAddress"
               name="InsAddress"
               required />
    </div>

    <div class="form-group">
        <label for="InsSalary">Salary:</label>

        <input type="number"
               class="form-control"
               id="InsSalary"
               name="InsSalary"
               step="0.01"
               required />
    </div>

    <div class="mb-3">
        <label for="InsImageUrl" class="form-label">
            ImageUrl
        </label>

        <input type="text"
               class="form-control"
               id="InsImageUrl"
               name="InsImageUrl" />
    </div>

    <div class="form-group">
        <label for="InsDepartmentId">
            Department:
        </label>

        <select class="form-control"
                id="InsDepartmentId"
                name="InsDepartmentId"
                required>

            <option value="">
                Select Department
            </option>

            @foreach (var dept in Model.Departments)
            {
                <option value="@dept.Id">
                    @dept.Name
                </option>
            }

        </select>
    </div>

    <br />
    <div class="form-group">
        <label>Course:</label>

        <select class="form-control"
                name="InsCourseId"
                required>

            <option value="">Select Course</option>

            @foreach (var course in Model.Courses)
            {
                <option value="@course.Id">
                    @course.Name
                </option>
            }

        </select>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Add Instructor
    </button>

</form>