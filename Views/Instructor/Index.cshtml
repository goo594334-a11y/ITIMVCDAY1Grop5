
@model InsDataAllNameDepartmentNameCourse


<h1>@Model.NameUser</h1>
<table class="table table-bordered table-hover">

    
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Address</th>
        <th>Salary</th>
        <td>DepartmentName</td>
        <td>CourseName</td>
    </tr>
    @foreach (var item in Model.Instructors)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Address</td>
            <td>@item.Salary</td>
            <td>@(item.Department?.Name ?? "No Department")</td>
            <td>@(item.Course?.Name ?? "No Course")</td>
        </tr>
    }
</table>

